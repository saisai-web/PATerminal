  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "check:architecture": "node scripts/check-source-layout.mjs",
    "generate:eula-manifest": "node scripts/eula-manifest.mjs",
    "check:eula": "node scripts/eula-manifest.mjs --check",
